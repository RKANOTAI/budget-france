{
  "$defs": {
    "MatchKind": {
      "description": "How a search hit matched the query.",
      "enum": [
        "exact",
        "lexical",
        "semantic"
      ],
      "title": "MatchKind",
      "type": "string"
    },
    "NodeType": {
      "description": "The three levels of the budget tree.",
      "enum": [
        "mission",
        "programme",
        "action"
      ],
      "title": "NodeType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "A deterministic search result, never an explanation.",
  "properties": {
    "code": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Code"
    },
    "match_kind": {
      "$ref": "#/$defs/MatchKind",
      "description": "exact or lexical is a direct match; semantic is a reconstruction, not an exact result"
    },
    "name": {
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "node_id": {
      "format": "uuid",
      "title": "Node Id",
      "type": "string"
    },
    "node_type": {
      "$ref": "#/$defs/NodeType"
    },
    "score": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Score",
      "type": "number"
    }
  },
  "required": [
    "node_id",
    "node_type",
    "name",
    "score",
    "match_kind"
  ],
  "title": "SearchHit",
  "type": "object"
}
