{
  "$defs": {
    "BudgetValue": {
      "additionalProperties": false,
      "anyOf": [
        {
          "properties": {
            "ae": {
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
              "type": "string"
            }
          },
          "required": [
            "ae"
          ]
        },
        {
          "properties": {
            "cp": {
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
              "type": "string"
            }
          },
          "required": [
            "cp"
          ]
        }
      ],
      "description": "Separated authorisations (AE) and payment credits (CP).",
      "properties": {
        "ae": {
          "anyOf": [
            {
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ae"
        },
        "cp": {
          "anyOf": [
            {
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cp"
        },
        "currency": {
          "const": "EUR",
          "default": "EUR",
          "title": "Currency",
          "type": "string"
        }
      },
      "title": "BudgetValue",
      "type": "object"
    },
    "Explanation": {
      "additionalProperties": false,
      "description": "Source-grounded prose; limitations must state when context is unavailable.",
      "properties": {
        "limitations": {
          "minLength": 1,
          "title": "Limitations",
          "type": "string"
        },
        "main_changes": {
          "minLength": 1,
          "title": "Main Changes",
          "type": "string"
        },
        "source_fragment_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Fragment Ids",
          "type": "array"
        },
        "summary": {
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "what_it_funds": {
          "minLength": 1,
          "title": "What It Funds",
          "type": "string"
        }
      },
      "required": [
        "summary",
        "what_it_funds",
        "main_changes",
        "limitations",
        "source_fragment_ids"
      ],
      "title": "Explanation",
      "type": "object"
    },
    "FiscalYear": {
      "description": "Fiscal years covered by the MVP contracts.",
      "enum": [
        2025,
        2026
      ],
      "title": "FiscalYear",
      "type": "integer"
    },
    "HistoryPoint": {
      "additionalProperties": false,
      "description": "One fiscal-year budget value in a node's history.",
      "properties": {
        "budget": {
          "$ref": "#/$defs/BudgetValue"
        },
        "provenance": {
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "minItems": 1,
          "title": "Provenance",
          "type": "array"
        },
        "year": {
          "$ref": "#/$defs/FiscalYear"
        }
      },
      "required": [
        "year",
        "budget",
        "provenance"
      ],
      "title": "HistoryPoint",
      "type": "object"
    },
    "NodeDetail": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "node_type": {
                "const": "mission"
              }
            }
          },
          "then": {
            "properties": {
              "children": {
                "items": {
                  "properties": {
                    "node_type": {
                      "const": "programme"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "node_type": {
                "const": "programme"
              }
            }
          },
          "then": {
            "properties": {
              "children": {
                "items": {
                  "properties": {
                    "node_type": {
                      "const": "action"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "node_type": {
                "const": "action"
              }
            }
          },
          "then": {
            "properties": {
              "children": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "node_type": {
                "const": "mission"
              }
            }
          },
          "then": {
            "properties": {
              "parent": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "node_type": {
                "const": "programme"
              }
            }
          },
          "then": {
            "properties": {
              "parent": {
                "allOf": [
                  {
                    "type": "object"
                  },
                  {
                    "properties": {
                      "node_type": {
                        "const": "mission"
                      }
                    }
                  }
                ]
              }
            },
            "required": [
              "parent"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "node_type": {
                "const": "action"
              }
            }
          },
          "then": {
            "properties": {
              "parent": {
                "allOf": [
                  {
                    "type": "object"
                  },
                  {
                    "properties": {
                      "node_type": {
                        "const": "programme"
                      }
                    }
                  }
                ]
              }
            },
            "required": [
              "parent"
            ]
          }
        }
      ],
      "description": "Detailed node view with release, history, provenance, and explanation.",
      "properties": {
        "budget": {
          "$ref": "#/$defs/BudgetValue"
        },
        "children": {
          "default": [],
          "items": {
            "$ref": "#/$defs/TreeNode"
          },
          "title": "Children",
          "type": "array"
        },
        "code": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Code"
        },
        "description": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "explanation": {
          "anyOf": [
            {
              "$ref": "#/$defs/Explanation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "history": {
          "default": [],
          "items": {
            "$ref": "#/$defs/HistoryPoint"
          },
          "title": "History",
          "type": "array"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "node_type": {
          "$ref": "#/$defs/NodeType"
        },
        "parent": {
          "anyOf": [
            {
              "$ref": "#/$defs/TreeNode"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "provenance": {
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "minItems": 1,
          "title": "Provenance",
          "type": "array"
        },
        "release": {
          "$ref": "#/$defs/ReleaseInfo"
        }
      },
      "required": [
        "id",
        "release",
        "node_type",
        "name",
        "budget",
        "provenance"
      ],
      "title": "NodeDetail",
      "type": "object"
    },
    "NodeType": {
      "description": "The three levels of the budget tree.",
      "enum": [
        "mission",
        "programme",
        "action"
      ],
      "title": "NodeType",
      "type": "string"
    },
    "ReleaseInfo": {
      "additionalProperties": false,
      "description": "Metadata identifying an immutable published release.",
      "properties": {
        "fiscal_year": {
          "$ref": "#/$defs/FiscalYear"
        },
        "release_id": {
          "format": "uuid",
          "title": "Release Id",
          "type": "string"
        },
        "released_at": {
          "format": "date-time",
          "pattern": "Z$",
          "title": "Released At",
          "type": "string"
        },
        "source_snapshot_hash": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-fA-F]{64}$",
          "title": "Source Snapshot Hash",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "release_id",
        "version",
        "released_at",
        "fiscal_year",
        "source_snapshot_hash"
      ],
      "title": "ReleaseInfo",
      "type": "object"
    },
    "SourceRef": {
      "additionalProperties": false,
      "description": "A verifiable reference to a source document fragment.",
      "properties": {
        "document_type": {
          "minLength": 1,
          "title": "Document Type",
          "type": "string"
        },
        "legal_stage": {
          "enum": [
            "PLF",
            "LFI"
          ],
          "title": "Legal Stage",
          "type": "string"
        },
        "locator": {
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        },
        "publication_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Publication Date"
        },
        "retrieved_at": {
          "format": "date-time",
          "pattern": "Z$",
          "title": "Retrieved At",
          "type": "string"
        },
        "sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-fA-F]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "source_fragment_id": {
          "format": "uuid",
          "title": "Source Fragment Id",
          "type": "string"
        },
        "source_version": {
          "minLength": 1,
          "title": "Source Version",
          "type": "string"
        },
        "url": {
          "format": "uri",
          "minLength": 1,
          "pattern": "^https?://(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)*[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?(?:[/?#][^\\s]*)?$",
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "source_fragment_id",
        "url",
        "sha256",
        "locator",
        "legal_stage",
        "document_type",
        "retrieved_at",
        "source_version"
      ],
      "title": "SourceRef",
      "type": "object"
    },
    "TreeNode": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "node_type": {
                "const": "mission"
              }
            }
          },
          "then": {
            "properties": {
              "children": {
                "items": {
                  "properties": {
                    "node_type": {
                      "const": "programme"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "node_type": {
                "const": "programme"
              }
            }
          },
          "then": {
            "properties": {
              "children": {
                "items": {
                  "properties": {
                    "node_type": {
                      "const": "action"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "node_type": {
                "const": "action"
              }
            }
          },
          "then": {
            "properties": {
              "children": {
                "maxItems": 0
              }
            }
          }
        }
      ],
      "description": "One node of the Mission → Programme → Action tree.",
      "properties": {
        "budget": {
          "$ref": "#/$defs/BudgetValue"
        },
        "children": {
          "default": [],
          "items": {
            "$ref": "#/$defs/TreeNode"
          },
          "title": "Children",
          "type": "array"
        },
        "code": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Code"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "node_type": {
          "$ref": "#/$defs/NodeType"
        },
        "source_refs": {
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "minItems": 1,
          "title": "Source Refs",
          "type": "array"
        }
      },
      "required": [
        "id",
        "node_type",
        "name",
        "budget",
        "source_refs"
      ],
      "title": "TreeNode",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "API envelope for a detailed budget node.",
  "properties": {
    "data": {
      "$ref": "#/$defs/NodeDetail"
    },
    "request_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Request Id"
    }
  },
  "required": [
    "data"
  ],
  "title": "NodeApiResponse",
  "type": "object"
}
